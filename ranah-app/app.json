{
  "expo": {
    "name": "CloClo",
    "slug": "cloclo-app",
    "scheme": "cloclo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow CloClo to use the microphone so you can record your own ringtones."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow CloClo to use the microphone for live call transcripts and recording your own ringtones.",
          "speechRecognitionPermission": "Allow CloClo to turn what you say on a call into a live transcript."
        }
      ]
    ]
  }
}
